# Server-side API Keys configuration for Perovskite SAM Extractor
# Rename this file to .env and fill in your API keys

# Gemini API Key (Default provider)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional provider / Cross-validation)
OPENAI_API_KEY=your_openai_api_key_here

# Server Port
PORT=8000
